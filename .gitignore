# Notebook / demo outputs: regenerated by every run, never committed
output/
*.png
!docs/*.png

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# NLTK / model caches
nltk_data/

# OS
.DS_Store

# Data quarantine: the ONLY data files tracked are the vendored demo corpus
# and the synthetic sample transcript, both allowlisted below.
*.csv
*.xlsx
*.qdpx
*.txt
!data/1_cleaned_data.csv
!data/raw/interview_demo01_20240115.txt
!docs/llm_reference_output.csv
!requirements.txt

# Slide decks are ignored by default: git keeps a committed blob in history even
# after it is deleted, and the Colab path in the setup cell clones this
# repository at the pinned tag, so anything tracked here is downloaded before
# the notebook can start. The AIMS deck is allowed through by name, as a
# deliberate exception; any other deck stays out.
*.pptx
*.key
!slides/0_abramson_AIMS_v3.pptx

# Office lock files. These appear beside an open document and must never ship.
~$*
.~lock.*
